# Modalia environment — copy to .env and fill real values (never commit .env)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_PROJECT_ID="your-project-id"
# Public site URL for SEO canonical URLs (server + client):
SITE_URL="https://your-domain.com"
VITE_SITE_URL="https://your-domain.com"
# Server-only (never expose to the client, never commit):
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"
